{
  "name": "snappy-bird",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-friendly WeChat mini-game foundation",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "configure:wechat": "node scripts/configure-wechat.mjs",
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release && node scripts/check-dist.mjs && node --test tests/package.smoke.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run format:check && npm run typecheck && npm run check:architecture && npm run check:design && npm test",
    "verify": "npm run check && npm run build && node scripts/check-dist.mjs && node --test tests/package.smoke.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "check:design": "node scripts/check-design.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "esbuild": "0.28.2",
    "minigame-api-typings": "3.8.21",
    "prettier": "3.9.8",
    "typescript": "5.9.3"
  }
}
